 import React, { useState, useEffect } from 'react';
import {
  View, Text, ScrollView, TouchableOpacity,
  TextInput, StyleSheet, StatusBar, Alert, Share
} from 'react-native';
import * as DocumentPicker from 'expo-document-picker';
import * as Sharing from 'expo-sharing';
import AsyncStorage from '@react-native-async-storage/async-storage';

const scholars = [
  'شیخ القرآن علامه سید عبدالسلام رستمي رحمه الله',
  'شیخ القرآن أبو محمد أمين الله البشاوري حفظه الله',
  'شیخ القرآن أبو محمد سردارولي ثاقب رحمه الله',
  'شیخ القرآن أبو عبيدالله متوكل رحمه الله',
  'شیخ القرآن أبو عمر عبدالمنان محمدي حفظه الله',
];

const categories = [
  'د قرآن کریم درسونه',
  'د احادیثو درسونه',
  'د تاریخ درسونه',
  'د فنونو درسونه',
  'د جمعې ورځې او عامې خطبې',
  'د شیخ تعارف او علمي آثار',
  'د سوالات او جوابات',
];

export default function App() {
  const [scholar, setScholar] = useState(null);
  const [category, setCategory] = useState(null);
  const [bookId, setBookId] = useState(null);
  const [screen, setScreen] = useState('home');
  const [language, setLanguage] = useState('پښتو');
  const [fontFamily, setFontFamily] = useState('sans-serif');
  const [searchQuery, setSearchQuery] = useState('');
  const [prayerTimes, setPrayerTimes] = useState({
    fajr: '05:00', dhuhr: '12:30', asr: '15:30',
    maghrib: '17:30', isha: '19:00',
  });
  const [settingsReady, setSettingsReady] = useState(false);
  const [books, setBooks] = useState({});
  const [storageReady, setStorageReady] = useState(false);
  const [notes, setNotes] = useState({});
  const [notesReady, setNotesReady] = useState(false);
  const [noteTarget, setNoteTarget] = useState(null);
  const [noteText, setNoteText] = useState('');
  const [newBook, setNewBook] = useState('');
  const [newChapter, setNewChapter] = useState('');
  const [newBab, setNewBab] = useState('');
  const [newLesson, setNewLesson] = useState('');
  const [pdfFile, setPdfFile] = useState(null);

  useEffect(() => {
    async function loadSettings() {
      try {
        const saved = await AsyncStorage.getItem('app_settings');
        if (saved) {
          const data = JSON.parse(saved);
          if (data.language) setLanguage(data.language);
          if (data.fontFamily) setFontFamily(data.fontFamily);
          if (data.prayerTimes) setPrayerTimes(data.prayerTimes);
        }
      } catch (error) {
        Alert.alert('خبرتیا', 'تنظیمات ونه لوستل شول');
      } finally {
        setSettingsReady(true);
      }
    }
    loadSettings();
  }, []);

  useEffect(() => {
    if (settingsReady) {
      AsyncStorage.setItem('app_settings', JSON.stringify({ language, fontFamily, prayerTimes }))
        .catch(() => Alert.alert('خبرتیا', 'تنظیمات خوندي نه شول'));
    }
  }, [language, fontFamily, prayerTimes, settingsReady]);

  useEffect(() => {
    async function loadBooks() {
      try {
        const saved = await AsyncStorage.getItem('library_books');
        if (saved) setBooks(JSON.parse(saved));
      } catch (error) {
        Alert.alert('خبرتیا', 'د کتابونو معلومات نه شول لوستل کېدای');
      } finally {
        setStorageReady(true);
      }
    }
    loadBooks();
  }, []);

  useEffect(() => {
    if (storageReady) {
      AsyncStorage.setItem('library_books', JSON.stringify(books))
        .catch(() => Alert.alert('خبرتیا', 'د کتابونو معلومات خوندي نه شول'));
    }
  }, [books, storageReady]);

  useEffect(() => {
    async function loadNotes() {
      try {
        const saved = await AsyncStorage.getItem('library_notes');
        if (saved) setNotes(JSON.parse(saved));
      } catch (error) {
        Alert.alert('خبرتیا', 'نوټونه ونه لوستل شول');
      } finally {
        setNotesReady(true);
      }
    }
    loadNotes();
  }, []);

  useEffect(() => {
    if (notesReady) {
      AsyncStorage.setItem('library_notes', JSON.stringify(notes))
        .catch(() => Alert.alert('خبرتیا', 'نوټونه خوندي نه شول'));
    }
  }, [notes, notesReady]);

  const key = scholar && category ? scholar + '|' + category : '';
  const currentBooks = books[key] || [];
  const currentBook = currentBooks.find(b => b.id === bookId);

  async function choosePDF() {
    try {
      const result = await DocumentPicker.getDocumentAsync({
        type: 'application/pdf',
        copyToCacheDirectory: true,
      });
      if (!result.canceled) {
        setPdfFile(result.assets[0]);
        Alert.alert('بریالی شو', 'PDF فایل انتخاب شو');
      }
    } catch (error) {
      Alert.alert('تېروتنه', String(error));
    }
  }

  async function openPDF() {
    try {
      if (!pdfFile || !pdfFile.uri) {
        Alert.alert('خبرتیا', 'لومړی PDF انتخاب کړه');
        return;
      }
      const available = await Sharing.isAvailableAsync();
      if (!available) {
        Alert.alert('خبرتیا', 'په دې وسیله کې د PDF شریکول فعال نه دي');
        return;
      }
      await Sharing.shareAsync(pdfFile.uri, {
        mimeType: 'application/pdf',
        UTI: 'com.adobe.pdf',
        dialogTitle: 'PDF کتاب شریک یا پرانیزئ',
      });
    } catch (error) {
      Alert.alert('د PDF تېروتنه', String(error));
    }
  }

  async function shareText(title, details = '') {
    try {
      await Share.share({
        message: `${title}${details ? '\n' + details : ''}\n\nد اسلامي علمي کتابتون له لارې`,
      });
    } catch (error) {
      Alert.alert('شریکول', 'شریکول ترسره نه شول: ' + String(error));
    }
  }

  function openNote(id, title) {
    setNoteTarget({ id, title });
    setNoteText(notes[id] || '');
    setScreen('note');
  }

  function saveNote() {
    if (!noteTarget) return;
    setNotes(old => ({ ...old, [noteTarget.id]: noteText }));
    Alert.alert('خوندي شو', 'ستاسو نوټ په موبایل کې خوندي شو');
    setScreen('notes');
  }

  function deleteNote(id) {
    Alert.alert('د نوټ حذفول', 'ایا دا نوټ حذف کړئ؟', [
      { text: 'نه', style: 'cancel' },
      {
        text: 'هو، حذف یې کړه',
        style: 'destructive',
        onPress: () => setNotes(old => {
          const updated = { ...old };
          delete updated[id];
          return updated;
        }),
      },
    ]);
  }

  function updateBooks(list) {
    setBooks(old => ({ ...old, [key]: list }));
  }

  function addBook() {
    if (!newBook.trim()) {
      Alert.alert('خبرتیا', 'د کتاب نوم ولیکئ');
      return;
    }
    updateBooks([...currentBooks, {
      id: String(Date.now()), name: newBook.trim(), pdf: null, chapters: [],
    }]);
    setNewBook('');
  }

  function updateBook(updated) {
    updateBooks(currentBooks.map(b => b.id === updated.id ? updated : b));
  }

  function addChapter() {
    if (!newChapter.trim() || !currentBook) {
      Alert.alert('خبرتیا', 'د فصل نوم ولیکئ');
      return;
    }
    updateBook({
      ...currentBook,
      chapters: [...currentBook.chapters, {
        id: String(Date.now()), name: newChapter.trim(), babs: [],
      }],
    });
    setNewChapter('');
  }

  function addBab(chapterId) {
    if (!newBab.trim() || !currentBook) {
      Alert.alert('خبرتیا', 'د باب نوم ولیکئ');
      return;
    }
    const chapters = currentBook.chapters.map(ch =>
      ch.id === chapterId
        ? { ...ch, babs: [...ch.babs, {
            id: String(Date.now()), name: newBab.trim(), lessons: [],
          }] }
        : ch
    );
    updateBook({ ...currentBook, chapters });
    setNewBab('');
  }

  function addLesson(chapterId, babId) {
    if (!newLesson.trim() || !currentBook) {
      Alert.alert('خبرتیا', 'د درس نوم ولیکئ');
      return;
    }
    const chapters = currentBook.chapters.map(ch => {
      if (ch.id !== chapterId) return ch;
      return {
        ...ch,
        babs: ch.babs.map(b =>
          b.id === babId
            ? { ...b, lessons: [...b.lessons, {
                id: String(Date.now()), name: newLesson.trim(),
              }] }
            : b
        ),
      };
    });
    updateBook({ ...currentBook, chapters });
    setNewLesson('');
  }

  function removeBook(id) {
    Alert.alert('د کتاب حذفول', 'ایا دا کتاب حذف کړئ؟', [
      { text: 'نه', style: 'cancel' },
      {
        text: 'هو، حذف یې کړه',
        style: 'destructive',
        onPress: () => {
          updateBooks(currentBooks.filter(b => b.id !== id));
          setBookId(null);
        },
      },
    ]);
  }

  function back() {
    if (screen === 'note') setScreen('notes');
    else if (screen === 'notes') setScreen('home');
    else if (screen === 'settings') setScreen('home');
    else if (bookId) setBookId(null);
    else if (category) setCategory(null);
    else if (scholar) setScholar(null);
  }

  function card(title, subtitle, action) {
    return (
      <TouchableOpacity style={styles.card} onPress={action}>
        <AppText style={styles.cardTitle}>{title}</AppText>
        {!!subtitle && <AppText style={styles.sub}>{subtitle}</AppText>}
        <AppText style={styles.arrow}>←</AppText>
      </TouchableOpacity>
    );
  }

  function addBox(label, value, setValue, placeholder, action, buttonText) {
    return (
      <View style={styles.addBox}>
        <AppText style={styles.label}>{label}</AppText>
        <TextInput
          style={[styles.input, { fontFamily }]}
          value={value}
          onChangeText={setValue}
          placeholder={placeholder}
          placeholderTextColor="#8A9B90"
          textAlign="right"
        />
        <TouchableOpacity style={styles.addButton} onPress={action}>
          <AppText style={styles.addText}>{buttonText}</AppText>
        </TouchableOpacity>
      </View>
    );
  }

  const translations = {
    'پښتو': { home:'کورپاڼه', library:'د علماؤ کرامو کتابتون', search:'عالم، کتاب یا درس ولټوئ', scholars:'علماء کرام', works:'علمي او د مطالعې برخې', audio:'غږیز درسونه', books:'کتابونه او PDF', quran:'قرآن او تفسیر', hadith:'حدیثونه', history:'اسلامي تاریخ', notes:'زما یادښتونه', social:'زموږ انټرنېټي پاڼې', socialHint:'د ټولنیزو پاڼو نښې؛ لینکونه به په راتلونکي اپډېټ کې فعال شي', settings:'تنظیمات', language:'د اپلیکیشن ژبه', font:'د لیکلو فونټ', sample:'د میراث اسلام کتابتون', choose:'د خپلې خوښې فونټ وټاکئ', adhkar:'اذکار او عبادت', morning:'سهار او ماښام اذکار', prayer:'د لمانځه وختونه', save:'انتخاب په موبایل کې خوندي کېږي', back:'بېرته کتابتون ته' },
    'العربية': { home:'الرئيسية', library:'مكتبة العلماء', search:'ابحث عن عالم أو كتاب أو درس', scholars:'العلماء', works:'أقسام العلم والمطالعة', audio:'الدروس الصوتية', books:'الكتب و PDF', quran:'القرآن والتفسير', hadith:'الأحاديث', history:'التاريخ الإسلامي', notes:'ملاحظاتي', social:'صفحاتنا على الإنترنت', socialHint:'روابط الصفحات ستضاف في التحديث القادم', settings:'الإعدادات', language:'لغة التطبيق', font:'نوع الخط', sample:'مكتبة ميراث الإسلام', choose:'اختر الخط المناسب', adhkar:'الأذكار والعبادة', morning:'أذكار الصباح والمساء', prayer:'أوقات الصلاة', save:'يُحفظ اختيارك على الهاتف', back:'العودة إلى المكتبة' },
    'اردو': { home:'ہوم', library:'علماء کی لائبریری', search:'عالم، کتاب یا سبق تلاش کریں', scholars:'علمائے کرام', works:'علمی اور مطالعے کے حصے', audio:'آڈیو دروس', books:'کتابیں اور PDF', quran:'قرآن اور تفسیر', hadith:'احادیث', history:'اسلامی تاریخ', notes:'میرے نوٹس', social:'ہمارے انٹرنیٹ صفحات', socialHint:'سوشل صفحات کے لنکس اگلی اپ ڈیٹ میں شامل ہوں گے', settings:'ترتیبات', language:'ایپ کی زبان', font:'فونٹ کا انتخاب', sample:'میراث اسلام لائبریری', choose:'اپنی پسند کا فونٹ منتخب کریں', adhkar:'اذکار اور عبادت', morning:'صبح و شام کے اذکار', prayer:'نماز کے اوقات', save:'آپ کا انتخاب فون میں محفوظ ہوگا', back:'لائبریری واپس جائیں' },
    'فارسي': { home:'خانه', library:'کتابخانه علمای کرام', search:'نام عالم، کتاب یا درس را جستجو کنید', scholars:'علمای کرام', works:'بخش‌های علمی و مطالعه', audio:'درس‌های صوتی', books:'کتاب‌ها و PDF', quran:'قرآن و تفسیر', hadith:'حدیث‌ها', history:'تاریخ اسلام', notes:'یادداشت‌های من', social:'صفحه‌های اینترنتی ما', socialHint:'پیوند صفحه‌ها در به‌روزرسانی آینده افزوده می‌شود', settings:'تنظیمات', language:'زبان برنامه', font:'انتخاب قلم', sample:'کتابخانه میراث اسلام', choose:'قلم دلخواه خود را انتخاب کنید', adhkar:'اذکار و عبادت', morning:'اذکار صبح و شام', prayer:'اوقات نماز', save:'انتخاب شما در تلفن ذخیره می‌شود', back:'بازگشت به کتابخانه' },
    'English': { home:'Home', library:'Scholars Library', search:'Search scholar, book or lesson', scholars:'Scholars', works:'Learning & Reading', audio:'Audio lessons', books:'Books & PDF', quran:'Quran & Tafsir', hadith:'Hadith', history:'Islamic history', notes:'My notes', social:'Our social pages', socialHint:'Social page links will be activated in a future update', settings:'Settings', language:'App language', font:'Font style', sample:'Mirاث Islam Library', choose:'Choose your preferred font', adhkar:'Adhkar & Worship', morning:'Morning & evening adhkar', prayer:'Prayer times', save:'Your choice is saved on this phone', back:'Back to library' }
  };
  const tr = key => (translations[language] && translations[language][key]) || translations['پښتو'][key] || key;
  const AppText = ({ style, ...props }) => <Text {...props} style={[{ fontFamily }, style]} />;

  return (
    <View style={[styles.container, { direction: language === 'English' ? 'ltr' : 'rtl' }]}>
      <StatusBar barStyle="light-content" backgroundColor="#071B16" />

      <View style={styles.header}>
        <AppText style={styles.logo}>میراث اسلام</AppText>
        <AppText style={styles.headerSub}>اسلامي علمي کتابتون</AppText>
      </View>

      <View style={styles.topActions}>
        <TouchableOpacity onPress={() => setScreen('settings')} style={styles.topButton}>
          <AppText style={styles.topButtonText}>⚙️ تنظیمات</AppText>
        </TouchableOpacity>
        <TouchableOpacity onPress={() => setScreen('notes')} style={styles.topButton}>
          <AppText style={styles.topButtonText}>📝 زما نوټونه ({Object.keys(notes).filter(k => notes[k]?.trim()).length})</AppText>
        </TouchableOpacity>
      </View>

      {(scholar || category || bookId || screen !== 'home') && (
        <TouchableOpacity style={styles.back} onPress={back}>
          <AppText style={styles.backText}>→ شاته تګ</AppText>
        </TouchableOpacity>
      )}

      <ScrollView contentContainerStyle={styles.content}>
        {screen === 'settings' && (
          <View style={styles.settingsPage}>
            <AppText style={styles.heading}>⚙️ {tr('settings')}</AppText>
            <View style={styles.settingPanel}>
              <AppText style={styles.settingTitle}>🌐 {tr('language')}</AppText>
              <View style={styles.languageGrid}>
                {['پښتو', 'العربية', 'اردو', 'فارسي', 'English'].map(lang => (
                  <TouchableOpacity key={lang} style={[styles.languageChip, language === lang && styles.selectedChip]} onPress={() => setLanguage(lang)}>
                    <AppText style={[styles.languageChipText, language === lang && styles.selectedChipText]}>{language === lang ? '✓ ' : ''}{lang}</AppText>
                  </TouchableOpacity>
                ))}
              </View>
            </View>
            <View style={styles.settingPanel}>
              <AppText style={styles.settingTitle}>Aa {tr('font')}</AppText>
              <AppText style={styles.settingHint}>{tr('choose')}</AppText>
              {[
                {name:'معیاري / Standard', family:'sans-serif'},
                {name:'کلاسیک / Serif', family:'serif'},
                {name:'منځنی / Medium', family:'sans-serif-medium'},
                {name:'تنګ / Condensed', family:'sans-serif-condensed'},
                {name:'روښانه / Light', family:'sans-serif-light'},
                {name:'مونو / Mono', family:'monospace'},
              ].map(item => (
                <TouchableOpacity key={item.family} style={[styles.fontOption, fontFamily === item.family && styles.fontOptionSelected]} onPress={() => setFontFamily(item.family)}>
                  <View style={{flex:1}}>
                    <AppText style={styles.fontName}>{item.name}</AppText>
                    <AppText style={[styles.fontSample, {fontFamily:item.family}]}>{tr('sample')}</AppText>
                  </View>
                  <AppText style={styles.fontCheck}>{fontFamily === item.family ? '✓' : '○'}</AppText>
                </TouchableOpacity>
              ))}
              <AppText style={styles.settingHint}>{tr('save')}</AppText>
            </View>
            <View style={styles.settingPanel}>
              <AppText style={styles.settingTitle}>🌅 {tr('adhkar')}</AppText>
              <AppText style={styles.label}>{tr('morning')}</AppText>
              {['آیت الکرسي', 'سورة الإخلاص', 'سورة الفلق', 'سورة الناس', 'أصبحنا وأصبح الملك لله', 'سبحان الله وبحمده'].map((item, index) => (
                <AppText key={index} style={styles.lesson}>{index + 1}. {item}</AppText>
              ))}
              <AppText style={styles.label}>🌙 ماښامني اذکار</AppText>
              {['آیت الکرسي', 'سورة الإخلاص', 'سورة الفلق', 'سورة الناس', 'أمسينا وأمسى الملك لله', 'أستغفر الله وأتوب إليه'].map((item, index) => (
                <AppText key={index} style={styles.lesson}>{index + 1}. {item}</AppText>
              ))}
            </View>
            <View style={styles.settingPanel}>
              <AppText style={styles.settingTitle}>🕌 {tr('prayer')}</AppText>
              {[[ 'فجر', 'fajr' ], [ 'ظهر', 'dhuhr' ], [ 'عصر', 'asr' ], [ 'مغرب', 'maghrib' ], [ 'عشاء', 'isha' ]].map(([name, id]) => (
                <View key={id}>
                  <AppText style={styles.label}>{name}: {prayerTimes[id]}</AppText>
                  <TextInput style={[styles.input, { fontFamily }]} value={prayerTimes[id]} placeholder="05:00" onChangeText={value => setPrayerTimes(old => ({...old, [id]:value}))}/>
                </View>
              ))}
            </View>
            <TouchableOpacity style={styles.addButton} onPress={() => setScreen('home')}>
              <AppText style={styles.addText}>{tr('back')}</AppText>
            </TouchableOpacity>
          </View>
        )}

        {screen === 'notes' && (
          <>
            <AppText style={styles.heading}>📝 زما خوندي شوي نوټونه</AppText>
            {Object.entries(notes).filter(([, value]) => value && value.trim()).length === 0 ? (
              <AppText style={styles.empty}>تر اوسه مو کوم نوټ نه دی ساتلی. د کتاب یا درس له برخې څخه نوټ جوړ کړئ.</AppText>
            ) : Object.entries(notes).filter(([, value]) => value && value.trim()).map(([id, value]) => (
              <View key={id} style={styles.noteCard}>
                <TouchableOpacity style={{ flex: 1 }} onPress={() => openNote(id, 'خوندي شوی نوټ')}>
                  <AppText style={styles.cardTitle}>📝 {id.startsWith('book|') ? 'د کتاب نوټ' : 'د درس نوټ'}</AppText>
                  <AppText style={styles.sub} numberOfLines={3}>{value}</AppText>
                </TouchableOpacity>
                <TouchableOpacity onPress={() => deleteNote(id)}>
                  <AppText style={styles.delete}>حذف</AppText>
                </TouchableOpacity>
              </View>
            ))}
          </>
        )}

        {screen === 'note' && noteTarget && (
          <View style={styles.addBox}>
            <AppText style={styles.heading}>📝 نوټ لیکل</AppText>
            <AppText style={styles.description}>{noteTarget.title}</AppText>
            <TextInput
              style={[styles.input, styles.noteInput, { fontFamily }]}
              value={noteText}
              onChangeText={setNoteText}
              placeholder="خپل نوټ دلته ولیکئ..."
              placeholderTextColor="#8A9B90"
              textAlign="right"
              multiline
              textAlignVertical="top"
            />
            <TouchableOpacity style={styles.addButton} onPress={saveNote}>
              <AppText style={styles.addText}>💾 نوټ خوندي کړه</AppText>
            </TouchableOpacity>
            <TouchableOpacity style={styles.smallButton} onPress={() => shareText(noteTarget.title, noteText)}>
              <AppText style={styles.addText}>↗️ نوټ شریک کړه</AppText>
            </TouchableOpacity>
            {!!notes[noteTarget.id] && (
              <TouchableOpacity style={styles.smallButton} onPress={() => deleteNote(noteTarget.id)}>
                <AppText style={styles.addText}>نوټ حذف کړه</AppText>
              </TouchableOpacity>
            )}
          </View>
        )}

        {screen === 'home' && !scholar && (
          <View style={styles.homePage}>
            <View style={styles.welcomePanel}>
              <AppText style={styles.welcomeEyebrow}>✦ {tr('library')} ✦</AppText>
              <AppText style={styles.welcomeTitle}>میراث اسلام</AppText>
              <AppText style={styles.welcomeSubtitle}>د علم، معرفت او اسلامي تاریخ خزانه</AppText>
              <TextInput style={[styles.searchInput, { fontFamily }]} value={searchQuery} onChangeText={setSearchQuery} placeholder={tr('search')} placeholderTextColor="#9FAE9F" textAlign="right" />
            </View>
            <TouchableOpacity style={styles.mainLibraryCard} onPress={() => { setSearchQuery(''); }}>
              <AppText style={styles.mainLibraryEyebrow}>✧ {tr('scholars')} ✧</AppText>
              <AppText style={styles.mainLibraryTitle}>{tr('library')}</AppText>
              <AppText style={styles.mainLibrarySub}>د علماؤ کرامو درسونه، کتابونه او علمي آثار</AppText>
              <View style={styles.scholarGrid}>
                {scholars.filter(item => item.toLowerCase().includes(searchQuery.toLowerCase())).map((item, index) => (
                  <TouchableOpacity key={item} style={styles.scholarTile} onPress={() => { setScholar(item); setCategory(null); setBookId(null); setSearchQuery(''); }}>
                    <AppText style={styles.scholarNumber}>{['01','02','03','04','05'][index] || '✦'}</AppText>
                    <AppText style={styles.scholarName}>{item}</AppText>
                    <AppText style={styles.scholarOpen}>کتابتون پرانیزئ ←</AppText>
                  </TouchableOpacity>
                ))}
              </View>
            </TouchableOpacity>
            <AppText style={styles.sectionTitle}>{tr('works')}</AppText>
            <View style={styles.featureGrid}>
              {[
                ['🎧',tr('audio'),'د علماؤ غږیز بیانونه'],['📚',tr('books'),'کتابونه او د مطالعې برخه'],
                ['📖',tr('quran'),'قرآن کریم او تفسیر'],['۞',tr('hadith'),'حدیثونه او شرح'],
                ['🏛',tr('history'),'د اسلامي تاریخ درسونه'],['📝',tr('notes'),'شخصي یادښتونه'],
              ].map(([icon,title,sub], index) => (
                <TouchableOpacity key={title} style={styles.featureCard} onPress={() => index === 5 ? setScreen('notes') : Alert.alert(title, 'دا برخه د علماؤ د کتابتون له لارې پرانیزئ؛ نور ځانګړي امکانات به په راتلونکو پړاوونو کې ورزیات شي.')}>
                  <AppText style={styles.featureIcon}>{icon}</AppText>
                  <AppText style={styles.featureTitle}>{title}</AppText>
                  <AppText style={styles.featureSub}>{sub}</AppText>
                </TouchableOpacity>
              ))}
            </View>
            <View style={styles.socialPanel}>
              <AppText style={styles.socialTitle}>{tr('social')}</AppText>
              <AppText style={styles.socialHint}>{tr('socialHint')}</AppText>
              <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={styles.socialRow}>
                {[
                  ['♪','TikTok'],['f','Facebook'],['𝕏','X'],['➤','Telegram'],['◎','Instagram'],['▶','YouTube']
                ].map(([symbol,name]) => (
                  <View key={name} style={styles.socialItem}>
                    <View style={styles.socialCircle}><AppText style={styles.socialSymbol}>{symbol}</AppText></View>
                    <AppText style={styles.socialName}>{name}</AppText>
                  </View>
                ))}
              </ScrollView>
            </View>
            <View style={styles.homeQuickActions}>
              <TouchableOpacity style={styles.quickButton} onPress={() => setScreen('notes')}><AppText style={styles.quickButtonText}>📝 {tr('notes')}</AppText></TouchableOpacity>
              <TouchableOpacity style={styles.quickButton} onPress={() => setScreen('settings')}><AppText style={styles.quickButtonText}>⚙️ {tr('settings')}</AppText></TouchableOpacity>
            </View>
          </View>
        )}

        {screen === 'home' && scholar && !category && (
          <>
            <AppText style={styles.heading}>د عالم کتابتون</AppText>
            <AppText style={styles.description}>{scholar}</AppText>
            {categories.map(item => card(item, 'د دې برخې کتابونه', () => setCategory(item)))}
          </>
        )}

        {screen === 'home' && scholar && category && !bookId && (
          <>
            <AppText style={styles.heading}>{category}</AppText>
            <AppText style={styles.description}>{scholar}</AppText>
            {addBox('نوی کتاب (اختیاري)', newBook, setNewBook, 'د کتاب نوم ولیکئ', addBook, '＋ کتاب اضافه کړه')}
            <AppText style={styles.sectionTitle}>کتابونه</AppText>
            {currentBooks.length === 0
              ? <AppText style={styles.empty}>تر اوسه کتاب نه دی اضافه شوی. دا برخه تشه هم پاتې کېدای شي.</AppText>
              : currentBooks.map(item => (
                <View style={styles.bookRow} key={item.id}>
                  <TouchableOpacity style={styles.bookName} onPress={() => setBookId(item.id)}>
                    <AppText style={styles.cardTitle}>📚 {item.name}</AppText>
                    <AppText style={styles.sub}>د کتاب جزئیات پرانیزئ</AppText>
                  </TouchableOpacity>
                  <View style={styles.rowActions}>
                    <TouchableOpacity onPress={() => openNote('book|' + item.id, item.name)}>
                      <AppText style={styles.actionText}>📝 نوټ</AppText>
                    </TouchableOpacity>
                    <TouchableOpacity onPress={() => shareText(item.name, `${scholar}\n${category}`)}>
                      <AppText style={styles.actionText}>↗️ شیر</AppText>
                    </TouchableOpacity>
                    <TouchableOpacity onPress={() => removeBook(item.id)}>
                      <AppText style={styles.delete}>حذف</AppText>
                    </TouchableOpacity>
                  </View>
                </View>
              ))
            }
          </>
        )}

        {screen === 'home' && currentBook && (
          <>
            <AppText style={styles.heading}>{currentBook.name}</AppText>
            <AppText style={styles.description}>{category}</AppText>

            <View style={styles.addBox}>
              <AppText style={styles.label}>د کتاب PDF (اختیاري)</AppText>
              <TouchableOpacity style={styles.addButton} onPress={choosePDF}>
                <AppText style={styles.addText}>📄 د PDF کتاب انتخابول</AppText>
              </TouchableOpacity>
              <AppText style={styles.empty}>{pdfFile ? pdfFile.name : 'تر اوسه PDF نه دی انتخاب شوی'}</AppText>
              <TouchableOpacity style={styles.smallButton} onPress={openPDF}>
                <AppText style={styles.addText}>📖 PDF شریک یا پرانیزئ</AppText>
              </TouchableOpacity>
            </View>

            <View style={styles.inlineActions}>
              <TouchableOpacity style={styles.smallButton} onPress={() => openNote('book|' + currentBook.id, currentBook.name)}>
                <AppText style={styles.addText}>📝 د کتاب نوټ</AppText>
              </TouchableOpacity>
              <TouchableOpacity style={styles.smallButton} onPress={() => shareText(currentBook.name, `${scholar}\n${category}`)}>
                <AppText style={styles.addText}>↗️ کتاب شریک کړه</AppText>
              </TouchableOpacity>
            </View>

            {addBox('نوی فصل (اختیاري)', newChapter, setNewChapter, 'د فصل نوم ولیکئ', addChapter, '＋ فصل اضافه کړه')}
            <AppText style={styles.sectionTitle}>فصلونه</AppText>
            {currentBook.chapters.length === 0 && (
              <AppText style={styles.empty}>فصلونه نشته. کتاب بې له فصله هم کار کوي.</AppText>
            )}

            {currentBook.chapters.map(chapter => (
              <View style={styles.chapterBox} key={chapter.id}>
                <AppText style={styles.chapterTitle}>📖 {chapter.name}</AppText>
                <AppText style={styles.label}>نوی باب (اختیاري)</AppText>
                <TextInput
                  style={[styles.input, { fontFamily }]}
                  value={newBab}
                  onChangeText={setNewBab}
                  placeholder="د باب نوم ولیکئ"
                  placeholderTextColor="#8A9B90"
                  textAlign="right"
                />
                <TouchableOpacity style={styles.smallButton} onPress={() => addBab(chapter.id)}>
                  <AppText style={styles.addText}>＋ باب اضافه کړه</AppText>
                </TouchableOpacity>

                {chapter.babs.length === 0 && <AppText style={styles.empty}>بابونه نشته؛ دا فصل همداسې پاتې کېدای شي.</AppText>}

                {chapter.babs.map(bab => (
                  <View style={styles.babBox} key={bab.id}>
                    <AppText style={styles.babTitle}>📁 {bab.name}</AppText>
                    <AppText style={styles.label}>نوی آډیو درس (اختیاري)</AppText>
                    <TextInput
                      style={[styles.input, { fontFamily }]}
                      value={newLesson}
                      onChangeText={setNewLesson}
                      placeholder="د درس نوم ولیکئ"
                      placeholderTextColor="#8A9B90"
                      textAlign="right"
                    />
                    <TouchableOpacity style={styles.smallButton} onPress={() => addLesson(chapter.id, bab.id)}>
                      <AppText style={styles.addText}>＋ درس اضافه کړه</AppText>
                    </TouchableOpacity>

                    {bab.lessons.length === 0 && <AppText style={styles.empty}>آډیو درس نشته؛ باب تش هم پاتې کېدای شي.</AppText>}

                    {bab.lessons.map(lesson => (
                      <View style={styles.lessonRow} key={lesson.id}>
                        <AppText style={[styles.lesson, { flex: 1 }]}>🎧 {lesson.name}</AppText>
                        <TouchableOpacity onPress={() => openNote('lesson|' + lesson.id, lesson.name)}>
                          <AppText style={styles.actionText}>📝 نوټ</AppText>
                        </TouchableOpacity>
                        <TouchableOpacity onPress={() => shareText(lesson.name, `${scholar}\n${category}\n${currentBook.name}\n${chapter.name} — ${bab.name}`)}>
                          <AppText style={styles.actionText}>↗️ شیر</AppText>
                        </TouchableOpacity>
                      </View>
                    ))}
                  </View>
                ))}
              </View>
            ))}
          </>
        )}
      </ScrollView>

      <View style={styles.footer}>
        <AppText style={styles.footerText}>میراث اسلام • اسلامي علمي کتابتون</AppText>
      </View>
    </View>
  );
}

